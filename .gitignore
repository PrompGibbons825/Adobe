# OS
.DS_Store

# Python
__pycache__/
*.pyc
.pytest_cache/

# Virtual environments
.venv/
venv/

# cr-renderer is a separate, external open-source project
# (https://github.com/CyberAgentAILab/cr-renderer), pulled in locally for
# reference/dev and installed by the engines via
# `pip install git+https://github.com/CyberAgentAILab/cr-renderer` — not
# vendored into this repo.
/cr-renderer/

# Generated run artifacts
output/*
!output/.gitkeep

# dev-only Crello sample (re-create with python -m tools.crello)
tools/crello/cache/
tools/crello/cases/assets/
tools/crello/cases/
tools/crello/eval/

# Combined engine: Jeff's large vision models are fetched at build time (tools/fetch_jeff_models.py)
/engine/subs/jeff/engine/models/u2netp.onnx
/engine/subs/jeff/engine/models/isnet-general-use.onnx
/engine/subs/jeff/engine/models/clip/
